{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "__MSG_extensionName__", "default_popup": "popup.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "__MSG_openPopup__"
    }
  },
  "options_page": "options.html"
}
